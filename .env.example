# Load from .env in the directory where epicor-mcp is started.
EPICOR_MCP_AUTH_MODE=none
EPICOR_MCP_HOST=127.0.0.1
EPICOR_MCP_PORT=8015
EPICOR_MCP_ENVIRONMENT=live

# Full Epicor REST v2 OData URL, including YOUR company ID and application path.
EPICOR_MCP_EPICOR_LIVE_URL=https://epicor.example.com/YourInstance/api/v2/odata/YOUR_COMPANY/
# Only used when EPICOR_MCP_ENVIRONMENT=pilot.
EPICOR_MCP_EPICOR_PILOT_URL=https://epicor.example.com/YourPilotInstance/api/v2/odata/YOUR_COMPANY/
# Sent as Epicor's Company header; use the same company ID as in the URL.
EPICOR_MCP_EPICOR_COMPANY_ID=YOUR_COMPANY
EPICOR_MCP_EPICOR_USERNAME=
EPICOR_MCP_EPICOR_PASSWORD=
EPICOR_MCP_EPICOR_API_KEY=
# Optional separate key for BAQ parsing/execution; falls back to EPICOR_API_KEY.
EPICOR_MCP_EPICOR_BAQ_API_KEY=
# Alternative to the three credential values above: an INI file, see
# .epicor_credentials.example. Values set in .env take precedence.
EPICOR_MCP_CREDENTIALS_PATH=

# Optional shared bearer token: strongly recommended for a hosted endpoint.
# It is a server-access token, NOT the Epicor API key.
EPICOR_MCP_SERVER_TOKEN=
EPICOR_MCP_RESPONSE_PUBLIC_BASE_URL=http://localhost:8015

# Copy table_whitelist.example.txt to this path and list allowed tables.
# Empty file = deny all. Missing/malformed file = startup error.
# Explicit empty setting disables the whitelist (built-in denylist still applies).
EPICOR_MCP_TABLE_WHITELIST_PATH=table_whitelist.txt
# Optional extra denials, one table per line (see table_blacklist.example.txt).
EPICOR_MCP_TABLE_BLACKLIST_PATH=table_blacklist.txt
# Optional administrator-supplied candidate keys for join diagnostics; not needed to start.
EPICOR_MCP_TABLE_KEYS_PATH=data/table_keys.json
# Optional JSON map of site (Plant) codes to names, included in MCP instructions.
# Read from .env or process environment. Blank = no hints; no access is granted.
# EPICOR_MCP_PLANTS={"10": "Main Plant", "20": "North Plant"}
EPICOR_MCP_PLANTS=

# No model services, index downloads or Internet forum searches by default.
# Semantic search (documents, and tables/fields when the discovery index was
# built with --model) needs the SAME provider and model that built the vectors.
EPICOR_MCP_VECTOR_SEARCH_ENABLED=false
EPICOR_MCP_EMBEDDING_MODEL=
EPICOR_MCP_DOCUMENT_VECTORS_PATH=data/document_vectors
# Endpoint provider, for a discovery index built with --endpoint (OpenAI-compatible).
EPICOR_MCP_EMBED_ENDPOINT=
EPICOR_MCP_EMBED_MODEL_NAME=
EPICOR_MCP_EMBED_DIM=2048
EPICOR_MCP_FORUM_LIVE_ENABLED=false
EPICOR_MCP_SQL_GROUND_DOMAINS=false
EPICOR_MCP_SQL_DIAGNOSE_EMPTY=false
EPICOR_MCP_ENABLE_BAQ_CREATE=false

# Every tool call is recorded locally (README, "Run and connect").
EPICOR_MCP_AUDIT_LOG_ENABLED=true
EPICOR_MCP_AUDIT_LOG_PATH=data/audit.db

# Optional Microsoft SSO: see docs/microsoft-sso.md before enabling.
EPICOR_MCP_AZURE_CLOUD=commercial
EPICOR_MCP_AZURE_TENANT_ID=
EPICOR_MCP_AZURE_CLIENT_ID=
EPICOR_MCP_AZURE_CLIENT_SECRET=
