{
 "sql": "WITH [w] AS (SELECT [A].[PartNum] AS [PartNum], [A].[ExtPriceDtl] AS [Amt] FROM Erp.OrderDtl AS [A] WHERE [A].[OrderNum] < 100000 UNION ALL SELECT [B].[PartNum] AS [PartNum], [B].[ExtPriceDtl] AS [Amt] FROM Erp.OrderDtl AS [B] WHERE [B].[OrderNum] >= 100000) SELECT TOP 10 [w].[PartNum] AS [PartNum], SUM([w].[Amt]) AS [Revenue] FROM [w] GROUP BY [w].[PartNum] ORDER BY SUM([w].[Amt]) DESC",
