{
 "sql": "select top 50 [OH].[PartNum] as [PartNum], [P].[PartDescription] as [Description], [PP].[CostMethod] as [CostMethod] from (select [PB].[Company] as [Company], [PB].[PartNum] as [PartNum], [W].[Plant] as [Plant], sum([PB].[OnhandQty]) as [Qty] from Erp.PartBin as [PB] inner join Erp.Warehse as [W] on [PB].[Company] = [W].[Company] and [PB].[WarehouseCode] = [W].[WarehouseCode] group by [PB].[Company], [PB].[PartNum], [W].[Plant]) as [OH] inner join Erp.Part as [P] on [OH].[Company] = [P].[Company] and [OH].[PartNum] = [P].[PartNum] inner join Erp.PartPlant as [PP] on [OH].[Company] = [PP].[Company] and [OH].[PartNum] = [PP].[PartNum] and [OH].[Plant] = [PP].[Plant]",
