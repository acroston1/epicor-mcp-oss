{
 "sql": "with [oh] as (select [PB].[Company] as [Company], [PB].[PartNum] as [PartNum], [W].[Plant] as [Plant], sum([PB].[OnhandQty]) as [Qty] from Erp.PartBin as [PB] inner join Erp.Warehse as [W] on [PB].[Company] = [W].[Company] and [PB].[WarehouseCode] = [W].[WarehouseCode] group by [PB].[Company], [PB].[PartNum], [W].[Plant]) select top 50 [oh].[PartNum] as [PartNum], [P].[PartDescription] as [Description], [PC].[StdMaterialCost] as [Std], [PP].[CostMethod] as [CostMethod] from [oh] inner join Erp.Part as [P] on [oh].[Company] = [P].[Company] and [oh].[PartNum] = [P].[PartNum] inner join Erp.PartCost as [PC] on [oh].[Company] = [PC].[Company] and [oh].[PartNum] = [PC].[PartNum] inner join Erp.PartPlant as [PP] on [oh].[Company] = [PP].[Company] and [oh].[PartNum] = [PP].[PartNum] and [oh].[Plant] = [PP].[Plant]",
