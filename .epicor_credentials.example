# Epicor service-account credentials for the MCP server.
#
# Copy this file to .epicor_credentials (gitignored) and set
#   EPICOR_MCP_CREDENTIALS_PATH=.epicor_credentials
# in .env. Alternatively leave that setting blank and put the same three
# values in .env as EPICOR_MCP_EPICOR_USERNAME / _PASSWORD / _API_KEY.
# Values in .env take precedence over this file when both are set.
#
# You need a dedicated Epicor service account (username + password) and an
# Epicor REST API key whose access scope covers the read methods listed in
# the README. Keep this file private and readable only by the server account.

[epicor]
username = your-service-account
password = your-password
api_key = your-epicor-api-key

# Optional: a separate key for BAQ parsing/execution. Defaults to api_key.
baq_api_key =

# Optional, Microsoft SSO mode only: key used for explicitly granted
# BAQ-save permissions. Leave blank for read-only operation.
write_api_key =
